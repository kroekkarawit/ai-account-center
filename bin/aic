#!/usr/bin/env bash
#
# aic — AI Account Center entrypoint.
# Thin launcher: locates its own real path, sources the lib/aic modules, then
# dispatches. All implementation lives in lib/aic/*.sh (loaded via _load.sh).

set -u
set -o pipefail

# Record the entrypoint path so resolve_self() (lib/aic/core.sh) can find the
# real install location even though it is defined in a sourced library file.
AIC_SELF="${BASH_SOURCE[0]}"

# Resolve this script's real directory, following symlinks (e.g. ~/.local/bin/aic).
__aic_src="$AIC_SELF"
while [[ -L "$__aic_src" ]]; do
  __aic_dir="$(cd -P "$(dirname "$__aic_src")" && pwd)"
  __aic_src="$(readlink "$__aic_src")"
  [[ "$__aic_src" != /* ]] && __aic_src="$__aic_dir/$__aic_src"
done
__aic_dir="$(cd -P "$(dirname "$__aic_src")" && pwd)"

# Locate the module loader. Normally it sits next to this script (../lib/aic),
# but tolerate a bare copy of just this file by falling back to AIC_APP_DIR and
# the default install location (mirrors find_codex_rate_limit_helper).
__aic_load=""
for __aic_c in \
  "$__aic_dir/../lib/aic/_load.sh" \
  "${AIC_APP_DIR:-$HOME/.local/share/ai-account-center}/lib/aic/_load.sh" \
  "$HOME/.local/share/ai-account-center/lib/aic/_load.sh"; do
  if [[ -f "$__aic_c" ]]; then __aic_load="$__aic_c"; break; fi
done
if [[ -z "$__aic_load" ]]; then
  printf 'aic: cannot locate lib/aic modules. Reinstall: curl -fsSL %s/raw/main/install.sh | bash\n' \
    "${AIC_REPO_URL:-https://github.com/kroekkarawit/ai-account-center}" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$__aic_load"
unset __aic_src __aic_dir __aic_load __aic_c

print_help() {
  cat <<HELP
$APP_NAME v$APP_VERSION

Everything is driven from the interactive menu — just run:

  aic                               Open the interactive menu
                                    (switch / add accounts, launch with a model
                                     profile, refresh usage, manage, settings,
                                     help & diagnostics)

A few non-interactive commands exist for scripting and the background scheduler:

  aic refresh [codex|claude NAME]   Refresh usage for all accounts, or one
  aic status                        Print cached usage for all accounts
  aic update [REF]                  Update $APP_NAME from GitHub
  aic uninstall [--purge-data]      Remove the install; keeps account data
  aic version                       Print the version

Open "Help" from the menu for the full account/model/schedule guide.
HELP
}

main() {
  local command="${1:-tui}"
  shift || true
  case "$command" in
    uninstall) uninstall_self "$@"; return ;;
    version|--version|-V) printf '%s\n' "$APP_VERSION"; return ;;
    help|--help|-h) print_help; return ;;
  esac

  require_command jq
  ensure_dirs
  reconcile_active_codex

  case "$command" in
    tui) interactive_menu ;;
    status) print_status ;;
    refresh)
      if [[ "${1:-}" == "--scheduled" || -z "${1:-}" ]]; then
        refresh_all
      elif [[ "${1:-}" == "codex" && -n "${2:-}" ]]; then
        refresh_codex_account "$2"
      elif [[ "${1:-}" == "claude" && -n "${2:-}" ]]; then
        refresh_claude_account "$2"
      else
        die "Use: aic refresh [codex|claude NAME]"
      fi
      ;;
    update) update_self "${1:-main}" ;;
    *)
      printf '%sUnknown command: %s%s  (account/model/schedule actions live in the menu — run: aic)\n\n' \
        "$RED" "$command" "$RESET" >&2
      print_help >&2
      exit 1
      ;;
  esac
}

main "$@"
